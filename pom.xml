<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.installr</groupId>
        <artifactId>installr-project</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>ic</artifactId>
    <version>0.2.0-SNAPSHOT</version>

    <description>ic - A command-line client for installrd</description>
    <url>https://installr.io</url>

    <scm>
        <connection>scm:git:https://github.com/installr-io/ic.git</connection>
        <developerConnection>git@github.com:installr-io/ic.git</developerConnection>
        <url>https://github.com/installr-io/ic</url>
    </scm>

    <properties>
        <!-- dependency versions -->
        <installr.version>0.3.0-SNAPSHOT</installr.version>

        <!-- packaging -->
        <non-packaged-resources.source.directory>
            ${project.basedir}/src/main/non-packaged-resources
        </non-packaged-resources.source.directory>
        <non-packaged-resources.target.directory>
            ${project.build.directory}/non-packaged-resources
        </non-packaged-resources.target.directory>
        <ic-bin.directory>/opt/installr-io/bin</ic-bin.directory>
        <ic-user>installr</ic-user>

        <!-- skip install & deploy -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- quarkus dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-picocli</artifactId>
        </dependency>

        <!-- our own dependencies -->
        <dependency>
            <groupId>io.installr</groupId>
            <artifactId>installr-lib-installrd</artifactId>
            <version>${installr.version}</version>
        </dependency>

        <!-- 3rd party dependencies -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-properties</artifactId>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>installr-io-maven-repo</id>
            <name>Installr.io Maven Repository</name>
            <url>https://maven.pkg.github.com/installr-io/installr</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>installr-io-maven-repo</id>
            <name>Installr.io Maven Repository</name>
            <url>https://maven.pkg.github.com/installr-io/installr</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-buildnumber</id>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-non-packaged-resources</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${non-packaged-resources.source.directory}</directory>
                                    <filtering>true</filtering>
                                    <excludes>
                                        <exclude>config/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${non-packaged-resources.source.directory}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>config/**</include>
                                    </includes>
                                </resource>
                            </resources>
                            <outputDirectory>${non-packaged-resources.target.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                        <configuration>
                            <systemProperties>
                                <quarkus.application.version>${project.version}-${build.revision}</quarkus.application.version>
                            </systemProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-linux-executable</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <concat binary="yes" destfile="${project.build.directory}/${project.build.finalName}"
                                    eol="unix">
                                    <filelist dir="${project.build.directory}"
                                        files="${non-packaged-resources.target.directory}/stub.sh" />
                                    <filelist dir="${project.build.directory}" files="${project.build.finalName}.jar" />
                                </concat>
                                <chmod file="${project.build.directory}/${project.build.finalName}" perm="0750" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
